---
import { Image } from "astro:assets";
import heroShot from "../assets/hero.png";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const t = useTranslations((Astro.currentLocale ?? "en") as Lang);
---

<section class="hero relative flex flex-col overflow-clip" id="top">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="moon-glow absolute left-1/2 top-[-320px] h-[720px] w-[720px] -translate-x-1/2 rounded-full"></div>
	</div>

	<div class="relative mx-auto flex w-full max-w-[1440px] flex-col px-(--padding-x) pb-10 pt-[100px] sm:flex-row sm:items-center sm:justify-between sm:pb-[104px] sm:pt-[139px]">
		<div class="flex w-full shrink-0 flex-col items-start sm:w-[600px]">
			<h1 class="mt-5 text-[40px] font-normal leading-[46px] tracking-[-0.01em] text-moon sm:mt-[26px] sm:text-[62px] sm:leading-[68px]">
				{t("hero.title.1")}<br />{t("hero.title.2")}<br />{t("hero.title.3")}
			</h1>
			<div class="mt-7 flex w-full items-end gap-[21px] sm:mt-[38px] sm:w-auto">
				<a
					href="#install"
					class="flex w-full items-center justify-center gap-[9px] rounded-sm border-t border-(--btn-border) bg-button px-5 py-3 text-[15px] font-semibold leading-[18px] text-moon shadow-[var(--btn-shadow)_0_1px_12px] transition-colors hover:bg-[#4a4a4a] sm:w-auto"
				>
					<svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0">
						<path d="M8 2.5 V10 M4.8 7 L8 10.2 L11.2 7 M3 13.5 H13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
					{t("hero.cta")}
				</a>
			</div>
			<p class="mt-5 font-mono text-xs leading-4 text-dusk sm:mt-[30px]">{t("hero.meta")}</p>
		</div>

		<!-- Screenshot -->
		<div class="mt-10 shrink-0 sm:mt-0">
			<Image
				class="h-auto w-full rounded-window object-cover shadow-[#05030C8C_0_3px_18px] sm:h-[406px] sm:w-[578px]"
				src={heroShot}
				alt={t("hero.shot.alt")}
				widths={[578, 1156, 1617]}
				sizes="578px"
				loading="eager"
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		background-image: radial-gradient(
			ellipse 40.17% 77.705% at 50% 10.85% in oklab,
			oklab(46.4% 0.02 -0.041 / 10%) 0%,
			oklab(81.2% 0.025 -0.036 / 4%) 100%
		);
	}

	.moon-glow {
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-moon) 7%, transparent) 0%,
			color-mix(in srgb, var(--color-moon) 3%, transparent) 42%,
			transparent 70%
		);
	}

	.moon-glow {
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-moon) 7%, transparent) 0%,
			color-mix(in srgb, var(--color-moon) 3%, transparent) 42%,
			transparent 70%
		);
	}
</style>

