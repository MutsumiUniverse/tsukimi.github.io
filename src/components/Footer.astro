---
import logo from "../assets/logo.svg";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const t = useTranslations((Astro.currentLocale ?? "en") as Lang);
---

<footer class="border-t border-moon/8 px-(--padding-x) py-7 sm:py-[34px]">
	<div class="mx-auto flex w-full max-w-[1312px] flex-col gap-[14px] sm:flex-row sm:items-center sm:justify-between">
		<div class="flex items-center gap-3">
			<img src={logo.src} alt="" width="22" height="22" class="rounded-md" />
			<span class="text-sm font-semibold leading-[18px] text-moon">Tsukimi</span>
			<span class="ml-3 text-[13px] leading-4 text-dusk">{t("footer.copyright")}</span>
		</div>
		<div class="flex items-center gap-[26px]">
			<a class="text-[13px] leading-4 text-moon transition-colors hover:text-dusk" href="https://github.com/tsukinaha/tsukimi" target="_blank" rel="noopener">GitHub</a>
			<a class="text-[13px] leading-4 text-moon transition-colors hover:text-dusk" href="https://github.com/tsukinaha/tsukimi/releases" target="_blank" rel="noopener">Releases</a>
			<a class="text-[13px] leading-4 text-moon transition-colors hover:text-dusk" href="https://flathub.org/apps/details/moe.tsuna.tsukimi" target="_blank" rel="noopener">Flathub</a>
			<a class="font-mono text-xs leading-4 text-dusk transition-colors hover:text-moon" href="https://github.com/tsukinaha/tsukimi/blob/main/LICENSE" target="_blank" rel="noopener">GPL-3.0</a>
		</div>
	</div>
</footer>
