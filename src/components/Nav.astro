---
import logo from "../assets/logo.svg";
import { useTranslations } from "../i18n/utils";
import { languages, type Lang } from "../i18n/ui";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = (Astro.currentLocale ?? "en") as Lang;
const t = useTranslations(lang);
---

<nav id="site-nav" class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-[240ms]">
  <div class="mx-auto flex w-full max-w-[1440px] items-center justify-between px-(--padding-x) py-4 sm:py-6">
    <a class="flex items-center gap-[9px] sm:gap-3" href="#top" aria-label="Tsukimi">
      <img src={logo.src} alt="" width="26" height="26" class="rounded-[7px] sm:h-[30px] sm:w-[30px] sm:rounded-sm" />
      <span class="text-[17px] font-semibold leading-[22px] tracking-[-0.01em] text-moon">Tsukimi</span>
    </a>
    <div class="flex items-center gap-[30px]">
      <a class="hidden text-sm leading-[18px] text-moon transition-colors hover:text-dusk sm:inline" href="#screenshots">
        {t("nav.screenshots")}
      </a>
      <a class="hidden text-sm leading-[18px] text-moon transition-colors hover:text-dusk sm:inline" href="#install">
        {t("nav.install")}
      </a>
      <div class="lang-switcher relative hidden sm:block">
        <button
          type="button"
          class="flex items-center cursor-pointer gap-1.5 font-mono text-xs leading-4 text-dusk transition-colors hover:text-moon"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          {languages[lang]}
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="shrink-0">
            <path
              d="M2.5 3.8 L5 6.3 L7.5 3.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <ul
          class="lang-menu invisible absolute right-0 top-full z-10 mt-2 min-w-[112px] translate-y-1 rounded-sm border border-moon/8 bg-[#1a1a1a] py-1 opacity-0 shadow-[#05030C8C_0_3px_18px] transition-[opacity,transform] duration-150"
          role="listbox"
        >
          {(Object.keys(languages) as Lang[]).map((l) => (
            <li role="option" aria-selected={l === lang}>
              <a
                class={`flex items-center justify-between px-3 py-1.5 font-mono text-xs leading-4 transition-colors ${l === lang ? "text-moon" : "text-dusk hover:text-moon"}`}
                href={getRelativeLocaleUrl(l)}
              >
                {languages[l]}
                {l === lang && (
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="shrink-0">
                    <path
                      d="M1.8 5.2 L4 7.4 L8.2 2.8"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <a
        class="flex items-center gap-2 rounded-sm border-t border-(--btn-border) bg-button px-[14px] py-2 shadow-[var(--btn-shadow)_0_1px_12px] transition-colors hover:bg-[#4a4a4a]"
        href="https://github.com/tsukinaha/tsukimi"
        target="_blank"
        rel="noopener"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0 text-moon">
          <path
            d="M8 0.2 C3.6 0.2 0 3.8 0 8.2 c0 3.5 2.3 6.5 5.4 7.6 c0.4 0.1 0.5 -0.2 0.5 -0.4 v-1.4 c-2.2 0.5 -2.7 -1 -2.7 -1 c-0.4 -0.9 -0.9 -1.2 -0.9 -1.2 c-0.7 -0.5 0.1 -0.5 0.1 -0.5 c0.8 0.1 1.2 0.8 1.2 0.8 c0.7 1.2 1.9 0.9 2.3 0.7 c0.1 -0.5 0.3 -0.9 0.5 -1.1 c-1.8 -0.2 -3.6 -0.9 -3.6 -3.9 c0 -0.9 0.3 -1.6 0.8 -2.1 c-0.1 -0.2 -0.4 -1 0.1 -2.1 c0 0 0.7 -0.2 2.2 0.8 c0.6 -0.2 1.3 -0.3 2 -0.3 s1.4 0.1 2 0.3 c1.5 -1 2.2 -0.8 2.2 -0.8 c0.5 1.1 0.2 1.9 0.1 2.1 c0.5 0.5 0.8 1.2 0.8 2.1 c0 3 -1.8 3.7 -3.6 3.9 c0.3 0.2 0.5 0.7 0.5 1.4 v2.1 c0 0.2 0.1 0.5 0.5 0.4 c3.1 -1.1 5.4 -4.1 5.4 -7.6 C16 3.8 12.4 0.2 8 0.2 Z"
            fill="currentColor"
          />
        </svg>
        <span class="text-sm font-medium leading-[18px] text-moon">GitHub</span>
        <span class="ml-1 flex items-center gap-1.5 border-l border-[#F5F3F738] pl-[13px] font-mono text-xs leading-4 text-moon">
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="shrink-0">
            <path d="M6 0.4 L7.5 4.3 L11.7 4.6 L8.6 7.3 L9.5 11.4 L6 9.2 L2.5 11.4 L3.4 7.3 L0.3 4.6 L4.5 4.3 Z" fill="currentColor" />
          </svg>
          {t("nav.stars")}
        </span>
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("site-nav");
  const onScroll = () => {
    nav?.classList.toggle("nav-scrolled", window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const switcher = nav?.querySelector<HTMLElement>(".lang-switcher");
  const switcherBtn = switcher?.querySelector<HTMLButtonElement>("button");
  const menu = switcher?.querySelector<HTMLElement>(".lang-menu");

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("invisible", !open);
    menu?.classList.toggle("opacity-0", !open);
    menu?.classList.toggle("translate-y-1", !open);
    switcherBtn?.setAttribute("aria-expanded", String(open));
  };

  switcherBtn?.addEventListener("click", () => {
    setOpen(switcherBtn.getAttribute("aria-expanded") !== "true");
  });
  document.addEventListener("click", (e) => {
    if (!switcher?.contains(e.target as Node)) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
</script>

<style>
  .nav-scrolled {
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-moon) 8%, transparent);
  }
</style>
