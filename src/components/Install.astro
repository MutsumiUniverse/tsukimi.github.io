---
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";

const t = useTranslations((Astro.currentLocale ?? "en") as Lang);

type Line = { type: "cmd" | "comment"; text: string };
type Option = { label: string; cmd: string; note: string };
type Distro = { name: string; lines?: Line[]; options?: Option[] };

const distros: Distro[] = [
  {
    name: "Flathub",
    lines: [
      { type: "cmd", text: "flatpak install flathub moe.tsuna.tsukimi" },
      { type: "comment", text: t("install.flathub.note") },
    ],
  },
  {
    name: "Arch Linux",
    options: [
      { label: "AUR binary", cmd: "paru -S tsukimi-bin", note: "aur.archlinux.org/packages/tsukimi-bin" },
      { label: "AUR git", cmd: "paru -S tsukimi-git", note: "aur.archlinux.org/packages/tsukimi-git" },
      { label: "Archlinuxcn", cmd: "sudo pacman -Syu tsukimi", note: "github.com/archlinuxcn/repo" },
      { label: "Archlinuxcn (git)", cmd: "sudo pacman -Syu tsukimi-git", note: "github.com/archlinuxcn/repo" },
    ],
  },
  {
    name: "Fedora",
    lines: [
      { type: "cmd", text: "sudo dnf copr enable walker874/tsukimi" },
      { type: "cmd", text: "sudo dnf install tsukimi" },
    ],
  },
  {
    name: "Nix",
    lines: [
      { type: "cmd", text: "nix profile install nixpkgs#tsukimi" },
      { type: "comment", text: t("install.nix.note") },
    ],
  },
  {
    name: "Gentoo",
    lines: [
      { type: "cmd", text: "sudo eselect repository enable gentoo-zh" },
      { type: "cmd", text: "sudo emerge --ask media-video/tsukimi" },
      { type: "comment", text: t("install.gentoo.note") },
    ],
  },
  {
    name: "AOSC OS",
    lines: [{ type: "cmd", text: "sudo oma install tsukimi" }],
  },
];
---

<section id="install" class="install px-(--padding-x) pb-[72px] pt-10 sm:pb-28 sm:pt-[104px]">
  <div class="mx-auto flex w-full max-w-[1312px] flex-col">
    <h2 class="text-[40px] font-normal leading-[46px] tracking-[-0.01em] text-moon sm:text-[56px] sm:leading-[60px]">
      {t("install.title")}
    </h2>

    <div
      class="mt-9 flex w-full flex-wrap items-center gap-0.5 rounded-sm bg-button sm:mt-14 sm:w-fit"
      role="tablist"
      aria-label={t("install.tabs")}
    >
      {distros.map((d, i) =>
        d.options ? (
          <div
            class="install-tab-wrap relative flex grow basis-[30%] items-center justify-center rounded-sm border-t border-transparent transition-colors sm:grow-0 sm:basis-auto"
            data-tab-wrap={i}
          >
            <button
              role="tab"
              aria-selected="false"
              aria-haspopup="listbox"
              aria-expanded="false"
              data-tab={i}
              data-options={JSON.stringify(d.options)}
              class="install-tab-btn flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-sm px-3 py-2.5 text-sm font-medium leading-[18px] text-inherit transition-colors sm:w-auto sm:px-6"
            >
              <span class="install-tab-label">{d.options[0].label}</span>
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="shrink-0 text-inherit transition-colors">
                <path
                  d="M2.5 3.8 L5 6.3 L7.5 3.8"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <ul
              class="install-tab-menu invisible absolute left-0 top-full z-10 mt-1 min-w-[160px] translate-y-1 rounded-sm border border-moon/8 bg-[#1a1a1a] py-1 opacity-0 shadow-[#05030C8C_0_3px_18px] transition-[opacity,transform] duration-150"
              role="listbox"
            >
              {d.options.map((o, j) => (
                <li role="option" aria-selected={j === 0} data-option={j}>
                  <button
                    type="button"
                    class={`flex w-full items-center justify-between px-3 py-1.5 text-left text-sm leading-[18px] transition-colors ${j === 0 ? "text-moon" : "text-dusk hover:text-moon"}`}
                  >
                    {o.label}
                    {j === 0 && (
                      <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" class="shrink-0">
                        <path
                          d="M1.8 5.2 L4 7.4 L8.2 2.8"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    )}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <button
            role="tab"
            aria-selected={i === 0}
            data-tab={i}
            class:list={[
              "flex grow basis-[30%] items-center justify-center rounded-sm border-t border-transparent px-3 py-2.5 text-sm leading-[18px] transition-colors cursor-pointer sm:grow-0 sm:basis-auto sm:px-6",
              i === 0 ? "bg-tab-active font-semibold text-moon border-(--btn-border)" : "font-medium text-tab-text hover:text-moon",
            ]}
          >
            {d.name}
          </button>
        ),
      )}
    </div>

    {distros.map((d, i) => (
      <div
        role="tabpanel"
        data-panel={i}
        class:list={["mt-5 flex flex-col gap-[14px] rounded-sm bg-bg px-5 py-6 sm:px-[34px] sm:py-[30px]", i !== 0 && "hidden"]}
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
          <div class="flex min-w-0 flex-col gap-[14px]">
            {d.options ? (
              <div class="flex flex-col gap-[14px]">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-base leading-5 text-dusk">$</span>
                  <code class="install-cmd font-mono text-sm leading-5 text-moon sm:text-base">{d.options[0].cmd}</code>
                </div>
                <p class="install-note font-mono text-[13px] leading-4 text-dusk"># {d.options[0].note}</p>
              </div>
            ) : (
              d.lines?.map((line) =>
                line.type === "cmd" ? (
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-base leading-5 text-dusk">$</span>
                    <code class="font-mono text-sm leading-5 text-moon sm:text-base">{line.text}</code>
                  </div>
                ) : (
                  <p class="font-mono text-[13px] leading-4 text-dusk">{line.text}</p>
                ),
              )
            )}
          </div>
          <button
            class="copy-btn flex w-fit shrink-0 items-center gap-2 self-start rounded-sm border-t border-(--btn-border) bg-button px-[14px] py-2 text-[13px] font-medium leading-4 text-moon shadow-[var(--btn-shadow)_0_1px_10px] transition-colors hover:bg-[#4a4a4a]"
            data-copy={
              d.options
                ? d.options[0].cmd
                : d.lines
                    ?.filter((l) => l.type === "cmd")
                    .map((l) => l.text)
                    .join("\n")
            }
          >
            <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true" class="shrink-0">
              <rect x="4.5" y="4.5" width="8" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
              <path
                d="M9.5 4.5 V3.5 A1.5 1.5 0 0 0 8 2 H3.5 A1.5 1.5 0 0 0 2 3.5 V8 A1.5 1.5 0 0 0 3.5 9.5 H4.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>
            <span class="copy-label" data-copy-label={t("install.copy")} data-copied-label={t("install.copied")}>
              {t("install.copy")}
            </span>
          </button>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .install {
    background-image: radial-gradient(
      ellipse 46.18% 129.615% at 50% 140.99% in oklab,
      oklab(35.1% 0.013 -0.021 / 21%) 0%,
      oklab(47.9% 0.006 -0.011 / 11%) 100%
    );
  }

  .install-tab-menu button {
    cursor: pointer;
  }
  .install-tab-menu [aria-selected="true"] {
    color: var(--color-moon);
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement | HTMLSelectElement>("[data-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-panel]");

  // Lock panel height to the tallest so the footer doesn't jump on tab switch
  let maxH = 0;
  panels.forEach((p) => {
    const wasHidden = p.classList.contains("hidden");
    if (wasHidden) p.classList.remove("hidden");
    maxH = Math.max(maxH, p.offsetHeight);
    if (wasHidden) p.classList.add("hidden");
  });
  panels.forEach((p) => (p.style.minHeight = `${maxH}px`));

  const activeClasses = ["bg-tab-active", "font-semibold", "text-moon"];
  const inactiveClasses = ["font-medium", "text-tab-text"];

  function setActiveTab(target: string) {
    tabs.forEach((t) => {
      const active = t.dataset.tab === target;
      t.setAttribute("aria-selected", String(active));
      const wrap = t.closest<HTMLElement>("[data-tab-wrap]");
      const el = wrap ?? t;
      el.classList.remove(...activeClasses, ...inactiveClasses, "hover:text-moon", "border-(--btn-border)", "border-transparent");
      el.classList.add(...(active ? activeClasses : inactiveClasses));
      el.classList.add(active ? "border-(--btn-border)" : "border-transparent");
      if (!active) el.classList.add("hover:text-moon");
    });
    panels.forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== target));
  }

  tabs.forEach((tab) => {
    const wrap = tab.closest<HTMLElement>("[data-tab-wrap]");
    if (wrap) {
      // Arch dropdown tab: button opens menu, option click selects + activates
      const menu = wrap.querySelector<HTMLElement>(".install-tab-menu");
      const label = wrap.querySelector<HTMLElement>(".install-tab-label");
      const options = JSON.parse(tab.dataset.options ?? "[]");

      const setOpen = (open: boolean) => {
        menu?.classList.toggle("invisible", !open);
        menu?.classList.toggle("opacity-0", !open);
        menu?.classList.toggle("translate-y-1", !open);
        tab.setAttribute("aria-expanded", String(open));
      };

      tab.addEventListener("click", () => {
        setActiveTab(tab.dataset.tab!);
        setOpen(tab.getAttribute("aria-expanded") !== "true");
      });

      menu?.querySelectorAll<HTMLElement>("[data-option]").forEach((li) => {
        li.querySelector("button")?.addEventListener("click", (e) => {
          e.stopPropagation();
          const idx = Number(li.dataset.option);
          const opt = options[idx];
          if (!opt) return;
          // Update label + checkmark
          if (label) label.textContent = opt.label;
          menu.querySelectorAll("[data-option]").forEach((l) => {
            const selected = l === li;
            l.setAttribute("aria-selected", String(selected));
            const btn = l.querySelector("button");
            btn?.classList.toggle("text-moon", selected);
            btn?.classList.toggle("text-dusk", !selected);
            btn?.classList.toggle("hover:text-moon", !selected);
            const check = btn?.querySelector("svg");
            if (check) check.style.display = selected ? "" : "none";
          });
          // Update panel content
          const panel = document.querySelector<HTMLElement>(`[data-panel="${tab.dataset.tab}"]`);
          if (panel) {
            const cmd = panel.querySelector<HTMLElement>(".install-cmd");
            const note = panel.querySelector<HTMLElement>(".install-note");
            const copyBtn = panel.querySelector<HTMLButtonElement>(".copy-btn");
            if (cmd) cmd.textContent = opt.cmd;
            if (note) note.textContent = `# ${opt.note}`;
            if (copyBtn) copyBtn.dataset.copy = opt.cmd;
          }
          setOpen(false);
        });
      });

      document.addEventListener("click", (e) => {
        if (!wrap.contains(e.target as Node)) setOpen(false);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
    } else {
      tab.addEventListener("click", () => setActiveTab(tab.dataset.tab!));
    }
  });
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const label = btn.querySelector<HTMLElement>(".copy-label");
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        if (label) {
          label.textContent = label.dataset.copiedLabel ?? "Copied";
          setTimeout(() => (label.textContent = label.dataset.copyLabel ?? "Copy"), 1500);
        }
      } catch {
        /* clipboard unavailable */
      }
    });
  });
</script>
